# ==========================================
# WatchTogether Environment Configuration
# ==========================================

# Backend Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/watchtogether?schema=public
# REDIS_URL is optional for single-instance local dev; required for multi-instance scaling
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters_long
COOKIE_SECURE=false
LOG_LEVEL=info
ROOM_TTL_MINUTES=1440
SYNC_INTERVAL_MS=3000
REQUEST_TTL_SECONDS=60

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000
